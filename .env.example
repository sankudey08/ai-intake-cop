# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Helicone
HELICONE_API_KEY=your-helicone-api-key
HELICONE_BASE_URL=https://oai.helicone.ai/v1   # swap to http://helicone:8585/v1 for self-hosted

# Google OAuth (Gmail + Calendar triggers)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly

# Budget Alerts
BUDGET_TOKEN_LIMIT=10000          # alert when session tokens exceed this
BUDGET_ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Prometheus / Grafana
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin123

# FastAPI
FASTAPI_PORT=8000
SECRET_KEY=change-me-in-production

# React dev server
VITE_API_BASE_URL=http://localhost:8000
VITE_HELICONE_API_KEY=your-helicone-api-key
